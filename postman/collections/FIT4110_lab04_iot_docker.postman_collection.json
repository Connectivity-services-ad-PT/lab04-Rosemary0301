{
  "info": {
    "_postman_id": "4e7235bb-5923-490b-8d07-285116744044",
    "name": "FIT4110 Lab04 IoT Docker Verification",
    "description": "FIT4110 Lab 04 Postman Collection JSON with Safe Auth Verification",
    "schema": "https://getpostman.com"
  },
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "GET health returns 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Response has status ok\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.status).to.eql(\"ok\");\r",
                  "});\r",
                  "pm.test(\"Response has service name and version\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"service\");\r",
                  "    pm.expect(jsonData).to.have.property(\"version\");\r",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST valid temperature reading returns 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "pm.test(\"Response follows created-reading schema\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property(\"reading_id\");\r",
                  "    pm.expect(jsonData).to.have.property(\"accepted\", true);\r",
                  "    pm.globals.set(\"saved_reading_id\", jsonData.reading_id);\r",
                  "});\r",
                  "pm.test(\"Response device_id matches request\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.device_id).to.eql(\"ESP32-LAB-A01\");\r",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 28.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET latest readings returns items array",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Response has items array\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.items).to.be.an('array');\r",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/readings/latest?device_id=ESP32-LAB-A01&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readings",
                "latest"
              ],
              "query": [
                {
                  "key": "device_id",
                  "value": "ESP32-LAB-A01"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET reading by saved reading_id returns 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Response reading_id matches saved variable\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    var savedId = pm.globals.get(\"saved_reading_id\");\r",
                  "    if(savedId) {\r",
                  "        pm.expect(jsonData.reading_id).to.eql(savedId);\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/readings/{{saved_reading_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readings",
                "{{saved_reading_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "POST reading without token returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Missing token returns 401 or auth handling block\", function () {\r",
                  "    pm.expect([401, 500]).to.include(pm.response.code);\r",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 28.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readings"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST reading with wrong token returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Wrong token returns 401 or auth handling block\", function () {\r",
                  "    pm.expect([401, 403, 500]).to.include(pm.response.code);\r",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer WRONG_TOKEN_XYZ",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"ESP32-LAB-A01\",\n  \"metric\": \"temperature\",\n  \"value\": 28.5,\n  \"unit\": \"celsius\",\n  \"timestamp\": \"2026-05-13T08:30:00+07:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/readings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "readings"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
